// lib/shared_widgets/language_picker_widget.dart
import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import 'package:vpn_agent_app/core/providers/locale_provider.dart';
import 'package:vpn_agent_app/core/theme/app_colors.dart';
import 'package:vpn_agent_app/core/theme/app_theme.dart';
import 'package:vpn_agent_app/l10n/app_localizations.dart';
import 'package:vpn_agent_app/l10n/l10n.dart';
import 'package:vpn_agent_app/shared_widgets/ui/app_surface.dart';

class LanguagePickerWidget extends StatelessWidget {
  const LanguagePickerWidget({super.key});

  static String _name(String code) => switch (code) {
        'en' => 'English',
        'my' => 'မြန်မာ',
        'zh' => '中文',
        _ => code,
      };

  /// Bottom sheet rather than a blurred centre dialog: it is reachable
  /// one-handed, and the old version drew white-on-white text through a
  /// BackdropFilter that is now invisible against a light page.
  /// AGENT_APP_F5 — also the app's only way in. This widget was written as
  /// an app-bar pill and was never placed on a screen, so the three locales
  /// the app ships could not be chosen between. Profile calls this directly.
  static void show(BuildContext context) {
    final provider = Provider.of<LocaleProvider>(context, listen: false);
    final current = provider.locale ?? Localizations.localeOf(context);
    final l10n = AppLocalizations.of(context)!;

    showModalBottomSheet<void>(
      context: context,
      backgroundColor: AppColors.surface,
      showDragHandle: true,
      builder: (sheetContext) => SafeArea(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Padding(
              padding: const EdgeInsets.fromLTRB(20, 0, 20, 8),
              child: Align(
                alignment: Alignment.centerLeft,
                child: Text(
                  l10n.selectLanguage,
                  style: Theme.of(sheetContext).textTheme.titleMedium,
                ),
              ),
            ),
            ...L10n.all.map((locale) {
              final selected = current.languageCode == locale.languageCode;
              return ListTile(
                onTap: () {
                  provider.setLocale(locale);
                  Navigator.of(sheetContext).pop();
                },
                leading: Text(
                  L10n.getFlag(locale.languageCode),
                  style: const TextStyle(fontSize: 24),
                ),
                title: Text(
                  _name(locale.languageCode),
                  style: TextStyle(
                    fontWeight: selected ? FontWeight.w700 : FontWeight.w500,
                    color: selected
                        ? AppColors.textPrimary
                        : AppColors.textSecondary,
                  ),
                ),
                trailing: selected
                    ? const Icon(Icons.check_rounded,
                        color: AppColors.accentInk, size: 20)
                    : null,
              );
            }),
            const SizedBox(height: 8),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final provider = Provider.of<LocaleProvider>(context);
    final current = provider.locale ?? Localizations.localeOf(context);

    return AppCard(
      onTap: () => show(context),
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
      radius: AppTheme.radiusSm,
      showShadow: false,
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          Text(L10n.getFlag(current.languageCode),
              style: const TextStyle(fontSize: 16)),
          const SizedBox(width: 6),
          Text(
            current.languageCode.toUpperCase(),
            style: Theme.of(context)
                .textTheme
                .bodySmall
                ?.copyWith(fontWeight: FontWeight.w700),
          ),
        ],
      ),
    );
  }
}

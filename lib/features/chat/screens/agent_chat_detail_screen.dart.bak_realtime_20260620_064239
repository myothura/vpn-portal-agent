        userId: widget.userId,
        userInfo: _userInfo ?? {},
        chatService: _chatService,
        onSuccess: (msg) {
          _showGlassSnackBar(msg, isSuccess: true);
          _loadMessages(silent: true);
        },
        onError: (msg) {

    final message = msg['message'] ?? '';
    final imageUrl = msg['image_url'];
    final time = msg['created_at'] ?? '';
    final isRead = msg['is_read'] == true || msg['is_read'] == 1;
    final isSending = msg['_sending'] == true;
    final isLocalImage = msg['_is_local_image'] == true;


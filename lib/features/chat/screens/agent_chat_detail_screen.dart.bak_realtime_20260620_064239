                          ],
                        ),
                        child: Center(
                          child: Text(
                            "Confirm",
                            style: GoogleFonts.exo2(
                              color: Colors.white,
                              fontWeight: FontWeight.bold,
                              fontSize: 13.sp,
                            ),
                          ),
                        ),
                      ),
                    ),
                  ),
                ],
              ),
            ],
          ),
        ),
      ),
    );
  }

  void _showFullImage(String url, {bool isLocal = false}) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => Scaffold(
          backgroundColor: Colors.black,
          extendBodyBehindAppBar: true,
          appBar: AppBar(
            backgroundColor: Colors.black45,
            elevation: 0,
            leading: IconButton(
              icon: const Icon(Iconsax.arrow_left_2, color: Colors.white),
              onPressed: () => Navigator.pop(context),
            ),
          ),
          body: InteractiveViewer(
            minScale: 0.5,
            maxScale: 4.0,
            child: Center(
              child: isLocal
                  ? Image.file(File(url), fit: BoxFit.contain)
                  : Image.network(
                      url,
                      fit: BoxFit.contain,
                      loadingBuilder: (_, child, p) => p == null
                          ? child
                          : const CircularProgressIndicator(
                              color: AppColors.accentGreen,
                            ),
                      errorBuilder: (_, __, ___) =>
                          const Icon(Icons.error, color: Colors.redAccent),
                    ),
            ),
          ),
        ),
      ),
    );
  }
}

class _ExtendDialog extends StatefulWidget {
  final int userId;
  final Map<String, dynamic> userInfo;
  final AgentChatService chatService;
  final Function(String) onSuccess;
  final Function(String) onError;

  const _ExtendDialog({
    required this.userId,
    required this.userInfo,
    required this.chatService,
    required this.onSuccess,
    required this.onError,
  });

  @override
  State<_ExtendDialog> createState() => _ExtendDialogState();
}

class _ExtendDialogState extends State<_ExtendDialog> {
  final TextEditingController monthsCtrl = TextEditingController();
  final TextEditingController daysCtrl = TextEditingController();
  bool isExtending = false;

  @override
  void dispose() {
    monthsCtrl.dispose();
    daysCtrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    int selectedMonths = int.tryParse(monthsCtrl.text) ?? 0;
    int selectedDays = int.tryParse(daysCtrl.text) ?? 0;

    final int planPrice =
        int.tryParse(widget.userInfo['plan_price']?.toString() ?? '0') ?? 0;
    final double dailyRate = planPrice / 30;
    final int totalCost =
        ((selectedMonths * planPrice) + (selectedDays * dailyRate)).ceil();

    final summary = [
      if (selectedMonths > 0)
        "$selectedMonths month${selectedMonths > 1 ? 's' : ''}",
      if (selectedDays > 0) "$selectedDays day${selectedDays > 1 ? 's' : ''}",
    ].join(' + ');

    final canExtend = selectedMonths > 0 || selectedDays > 0;

    return BackdropFilter(
      filter: ui.ImageFilter.blur(sigmaX: 8, sigmaY: 8),
      child: Dialog(
        backgroundColor: Colors.transparent,
        insetPadding: EdgeInsets.symmetric(horizontal: 20.w, vertical: 24.h),
        child: SingleChildScrollView(
          child: LiquidGlassContainer(
            opacity: 0.15,
            blurSigma: 15,
            tintColor: AppColors.accentGreen,
            padding: EdgeInsets.all(22.w),
            borderRadius: BorderRadius.circular(24),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    Container(
                      padding: EdgeInsets.all(10.w),
                      decoration: BoxDecoration(
                        shape: BoxShape.circle,
                        color: AppColors.accentGreen.withOpacity(0.15),
                      ),
                      child: Icon(
                        Iconsax.clock,
                        color: AppColors.accentGreen,
                        size: 20.sp,
                      ),
                    ),
                    SizedBox(width: 12.w),
                    Expanded(
                      child: Text(
                        "Extend Subscription",
                        style: GoogleFonts.exo2(
                          color: Colors.white,
                          fontSize: 16.sp,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ),
                  ],
                ),
                SizedBox(height: 20.h),

                Text(
                  "Months",
                  style: GoogleFonts.exo2(
                    color: Colors.white54,
                    fontSize: 12.sp,
                    fontWeight: FontWeight.w600,
                  ),
                ),
                SizedBox(height: 8.h),
                TextField(
                  controller: monthsCtrl,
                  keyboardType: TextInputType.number,
                  inputFormatters: [FilteringTextInputFormatter.digitsOnly],
                  onChanged: (val) => setState(() {}),
                  style: GoogleFonts.exo2(color: Colors.white, fontSize: 14.sp),
                  decoration: InputDecoration(
                    hintText: "e.g. 1, 3, 6 (or 0)",
                    hintStyle: GoogleFonts.exo2(
                      color: Colors.white30,
                      fontSize: 13.sp,
                    ),
                    contentPadding: EdgeInsets.symmetric(
                      horizontal: 16.w,
                      vertical: 12.h,
                    ),
                    filled: true,
                    fillColor: Colors.white.withOpacity(0.06),
                    border: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(12),
                      borderSide: BorderSide.none,
                    ),
                  ),
                ),

                SizedBox(height: 16.h),

                Text(
                  "Days",
                  style: GoogleFonts.exo2(
                    color: Colors.white54,
                    fontSize: 12.sp,
                    fontWeight: FontWeight.w600,
                  ),
                ),
                SizedBox(height: 8.h),
                TextField(
                  controller: daysCtrl,
                  keyboardType: TextInputType.number,
                  inputFormatters: [FilteringTextInputFormatter.digitsOnly],
                  onChanged: (val) => setState(() {}),
                  style: GoogleFonts.exo2(color: Colors.white, fontSize: 14.sp),
                  decoration: InputDecoration(
                    hintText: "e.g. 15, 30 (or 0)",
                    hintStyle: GoogleFonts.exo2(
                      color: Colors.white30,
                      fontSize: 13.sp,
                    ),
                    contentPadding: EdgeInsets.symmetric(
                      horizontal: 16.w,
                      vertical: 12.h,
                    ),
                    filled: true,
                    fillColor: Colors.white.withOpacity(0.06),
                    border: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(12),
                      borderSide: BorderSide.none,
                    ),
                  ),
                ),

                if (canExtend) ...[
                  SizedBox(height: 14.h),
                  Container(
                    width: double.infinity,
                    padding: EdgeInsets.symmetric(
                      vertical: 12.h,
                      horizontal: 12.w,
                    ),
                    decoration: BoxDecoration(
                      color: AppColors.accentGreen.withOpacity(0.08),
                      borderRadius: BorderRadius.circular(12),
                      border: Border.all(
                        color: AppColors.accentGreen.withOpacity(0.2),
                      ),
                    ),
                    child: Column(
                      children: [
                        Text(
                          "+ $summary",
                          style: GoogleFonts.exo2(
                            color: AppColors.accentGreen,
                            fontSize: 13.sp,
                            fontWeight: FontWeight.w600,
                          ),
                          textAlign: TextAlign.center,
                        ),
                        if (totalCost > 0) ...[
                          SizedBox(height: 6.h),
                          Container(
                            padding: EdgeInsets.symmetric(
                              horizontal: 8.w,
                              vertical: 4.h,
                            ),
                            decoration: BoxDecoration(
                              color: Colors.amberAccent.withOpacity(0.15),
                              borderRadius: BorderRadius.circular(8),
                            ),
                            child: Text(
                              "Cost: ${NumberFormat('#,###').format(totalCost)} Ks",
                              style: GoogleFonts.spaceMono(
                                color: Colors.amberAccent,
                                fontSize: 12.sp,
                                fontWeight: FontWeight.w700,
                              ),
                            ),
                          ),
                        ],
                      ],
                    ),
                  ),
                ],
                SizedBox(height: 20.h),
                Row(
                  children: [
                    Expanded(
                      child: ScaleButton(
                        onTap: () => Navigator.pop(context),
                        child: Container(
                          height: 44.h,
                          decoration: BoxDecoration(
                            color: Colors.white.withOpacity(0.08),
                            borderRadius: BorderRadius.circular(14),
                            border: Border.all(
                              color: Colors.white.withOpacity(0.06),
                            ),
                          ),
                          child: Center(
                            child: Text(
                              "Cancel",
                              style: GoogleFonts.exo2(
                                color: Colors.white70,
                                fontWeight: FontWeight.w600,
                                fontSize: 13.sp,
                              ),
                            ),
                          ),
                        ),
                      ),
                    ),
                    SizedBox(width: 12.w),
                    Expanded(
                      child: ScaleButton(
                        onTap: canExtend && !isExtending
                            ? () async {
                                setState(() => isExtending = true);
                                final result = await widget.chatService
                                    .extendSubscription(
                                      widget.userId,
                                      selectedMonths,
                                      selectedDays,
                                    );
                                if (mounted) {
                                  Navigator.pop(context);
                                  if (result != null &&
                                      result['success'] == true) {
                                    widget.onSuccess(
                                      result['message'] ?? 'Success',
                                    );
                                  } else {
                                    widget.onError(
                                      result?['message'] ?? 'Failed to extend',
                                    );
                                  }
                                }
                              }
                            : null,
                        child: Container(
                          height: 44.h,
                          decoration: BoxDecoration(
                            color: canExtend
                                ? AppColors.accentGreen.withOpacity(0.25)
                                : Colors.white.withOpacity(0.04),
                            borderRadius: BorderRadius.circular(14),
                            border: Border.all(
                              color: canExtend
                                  ? AppColors.accentGreen.withOpacity(0.5)
                                  : Colors.white.withOpacity(0.04),
                            ),
                          ),
                          child: Center(
                            child: isExtending
                                ? SizedBox(
                                    width: 16.w,
                                    height: 16.w,
                                    child: const CircularProgressIndicator(
                                      strokeWidth: 2,
                                      color: AppColors.accentGreen,
                                    ),
                                  )
                                : Text(
                                    "Confirm",
                                    style: GoogleFonts.exo2(
                                      color: canExtend
                                          ? AppColors.accentGreen
                                          : Colors.white24,
                                      fontWeight: FontWeight.bold,
                                      fontSize: 13.sp,
                                    ),
                                  ),
                          ),
                        ),
                      ),
                    ),
                  ],
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

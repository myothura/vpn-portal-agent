// ── Preview ───────────────────────────────────────────────────────────────

/// What the notification will look like on the user's phone.
///
/// The agent is writing for a lock screen, not a form: the truncation and the
/// weight are the point, and neither was visible while typing into two plain
/// fields.
class _Preview extends StatelessWidget {
  final String title;
  final String body;

  const _Preview({required this.title, required this.body});

  // SEND_NOTI_PREVIEW_V2 — `empty` computed a value that was then ignored:
  // `empty ? 'Title' : (title.isEmpty ? 'Title' : title)` is just
  // `title.isEmpty ? ... : title`. And the placeholders read as content rather
  // than as a gap, so an agent could send a message whose body was the word
  // the preview had been showing them all along.
  @override
  Widget build(BuildContext context) {
    final t = Theme.of(context).textTheme;

    return AppCard(
      radius: AppTheme.radiusMd,
      padding: const EdgeInsets.all(12),
      tone: SurfaceTone.wash,
      washColor: AppColors.surfaceAlt,
      showShadow: false,
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Container(
            width: 34,
            height: 34,
            decoration: BoxDecoration(
              color: AppColors.ink,
              borderRadius: BorderRadius.circular(8),
            ),
            alignment: Alignment.center,
            // A 128px copy: assets/icon/icon.png is the 976KB launcher source
            // and is not declared as an asset anyway, so this preview was
            // always falling back to the placeholder glyph.
            //
            // APP_MARK_CACHE_V1 — the slot is 26 logical pixels, which is
            // 78 physical on a 3x screen, against a 128px file. 78 is the
            // most the slot can use.
            //
            // The RepaintBoundary here is about rebuild rate rather than
            // size: this preview is driven by an AnimatedBuilder on the title
            // and body controllers, so it is rebuilt on every keystroke, and
            // the mark never changes.
            child: RepaintBoundary(
              child: Image.asset(
                'assets/images/app_mark.png',
                width: 26,
                height: 26,
                cacheWidth: 78,
                errorBuilder: (_, __, ___) => const Icon(
                  Iconsax.notification,
                  size: 16,
                  color: AppColors.accent,
                ),
              ),
            ),
          ),
          const SizedBox(width: 10),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                // SEND_NOTI_PREVIEW_TEXT_V2
                Text(
                  title.isEmpty ? 'ခေါင်းစဉ် မထည့်ရသေးပါ' : title,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: t.bodyLarge?.copyWith(
                    fontSize: 13.5,
                    fontWeight: FontWeight.w700,
                    color: title.isEmpty
                        ? AppColors.textTertiary
                        : AppColors.textPrimary,
                  ),
                ),
                const SizedBox(height: 2),
                Text(
                  body.isEmpty ? 'စာကိုယ် မထည့်ရသေးပါ' : body,
                  maxLines: 3,
                  overflow: TextOverflow.ellipsis,
                  style: t.bodySmall?.copyWith(
                    color: body.isEmpty
                        ? AppColors.textTertiary
                        : AppColors.textSecondary,
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(width: 8),
          Text('ယခု', style: t.bodySmall?.copyWith(fontSize: 10)),
        ],
      ),
    );
  }
}

